# ================================================================
# AiDash 环境变量示例（复制本文件为 .env 仅用于本地参考）
# 正式环境请在 Vercel 控制台 → Project → Settings → Environment Variables 里填写
# ================================================================

# AI 服务商：deepseek（默认，国内直连）/ openai
AI_PROVIDER=deepseek

# DeepSeek（https://platform.deepseek.com 创建 API Key）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# OpenAI（可选备选，需海外支付方式）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# GitHub fine-grained Token（仅授权 aidash 仓库 Contents 读写）
GITHUB_TOKEN=
GITHUB_REPO=jiejinfeilu/aidash
GITHUB_BRANCH=main

# 手机端口令（4~6 位，前端“设置”页需填写同一个）
APP_PIN=1234
